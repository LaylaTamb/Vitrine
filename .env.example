# Supabase → Project Settings → Data API
# A chave é a "anon" / publishable. NUNCA a service_role: ela ignora a RLS e
# tudo aqui é exposto ao navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional. Fixa o começo dos links dos e-mails (confirmar cadastro, criar
# senha) — útil atrás de proxy. Em branco, vale a origem de quem pediu. O
# endereço + /auth/callback precisa estar em Redirect URLs no Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Geoapify — procura os endereços do Mapa e traz horário, contato e trajeto
# nas Sugestões (veja "Configuração da Geoapify" no GUIA-LOCAL.md). Plano grátis,
# sem cartão. Sem ela, o resto do app funciona igual e só a busca de
# endereços avisa que falta. O desenho do mapa (OpenFreeMap) não usa chave.
# Só do SERVIDOR: NUNCA com o prefixo NEXT_PUBLIC_, ela não pode chegar ao
# navegador.
GEOAPIFY_API_KEY=sua-chave-da-geoapify

# Steam — "Conectar Steam" nas Configurações traz os jogos com as horas
# jogadas (veja "Configuração da Steam" no GUIA-LOCAL.md). Chave gratuita em
# https://steamcommunity.com/dev/apikey. Opcional: sem ela (e sem o
# CRON_SECRET abaixo), o botão avisa que a Steam não está ativada. Só do
# SERVIDOR: NUNCA com o prefixo NEXT_PUBLIC_.
STEAM_API_KEY=sua-chave-da-steam

# Segredo do servidor (no mínimo 32 caracteres; gere com `openssl rand -hex 32`).
# Protege a atualização diária (/api/cron/contas — Steam e Letterboxd; o Cron da
# Vercel manda ele sozinho) e abre as funções do banco que gravam as contas, os
# jogos e os filmes. O MESMO valor vai para o banco uma vez: veja o topo do
# supabase/24_connected_accounts.sql. O Letterboxd pelo @ só precisa dele.
CRON_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Google Gemini (plano gratuito) — "Sugerir campos com IA" ao criar uma
# categoria que ninguém tem parecida (veja "Sugestões de campos" no GUIA-LOCAL.md).
# Chave em https://aistudio.google.com/apikey. Recebe SÓ o nome da categoria;
# no plano gratuito o Google pode usar isso para treinar os modelos dele.
# Opcional: sem ela, o botão não aparece. Só do SERVIDOR: NUNCA com NEXT_PUBLIC_.
GEMINI_API_KEY=sua-chave-do-gemini
# Opcional: o modelo (padrão: gemini-flash-lite-latest).
# GEMINI_MODEL=gemini-flash-lite-latest
